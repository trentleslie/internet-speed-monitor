# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Collector data — live CSVs the Pi rewrites every poll, plus reproducible
# top-level plots. Kept on disk per the persist-results SOP, never committed.
# Exception: data/plots/ holds the figures embedded in reports/*.md, so those
# stay tracked as published deliverables.
data/*
!data/plots/
